{
  "manifest_version": 3,
  "name": "轻读 · Reading Cues",
  "version": "0.1.0",
  "description": "在本地为中文正文中的少量条件、限制与转折表达提供可定制提示。",
  "minimum_chrome_version": "105",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "轻读：阅读提示", "default_popup": "popup.html", "default_icon": {"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"} },
  "icons": {"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"},
  "options_page": "options.html",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'" }
}
